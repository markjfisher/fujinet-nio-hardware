          (instances (project "zorro-breakout" (path "/844a4445-00cb-5ef5-8061-30bfb610a6e7" (reference "TP3") (unit 1))))) (text "PASSIVE ZORRO-II BREAKOUT — no active electronics; no level shifting" (at 25 20 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 878604ba-4eb1-50c2-bf31-10e474e12089))(text "J1: odd contacts = reverse / even contacts = component side. Pin 28=A7; pin 29=A1." (at 25 315 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 3c99132d-98a7-5c7e-a47e-d550618e5f3e))(text "Reserved, NC, legacy and SenseZ3 points remain isolated. NC describes the host function, not an unrouted pad." (at 25 322 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid df402fbb-e0a3-535d-9f5b-dc40dbdea72d))(text "Paired header pins share the same net. CFGlN/CFGOUT are NOT bridged. See README for downstream-card configuration." (at 25 329 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid bb08baf0-7097-51c2-a580-acf31ac23e6d))(text "DO NOT CONNECT DIRECTLY TO 3.3V LOGIC WITHOUT CHECKING ELECTRICAL COMPATIBILITY" (at 25 336 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 6b47cdd0-dcec-50ac-86d1-7217347d6605))(text "Mechanical release hold: confirm bevel callout against a legible A-5 / mating connector drawing." (at 25 343 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 7c984625-3b39-5c43-9a74-942879a18d4e))(text "Fujinet-NIO Amiga Prototyping Board, © Mark Fisher 2026" (at 25 355 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid a8861076-5eac-5b77-9aec-b58da4bbc3f1)))